<Project Sdk="Microsoft.NET.Sdk">

  <!-- Frozen copy of the production engine at tag engine-v1-reference (commit e4af0e8).
       Source/ is byte-identical to that commit and is guarded by ReferenceIntegrityTests.
       Never edit it: it is the oracle every port is measured against. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>Purity.Reference.V1</AssemblyName>
    <RootNamespace>Purity</RootNamespace>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0219;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="4.7.11" />
  </ItemGroup>

</Project>
