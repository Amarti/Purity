<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia 11.3 fallback for older macOS, from the same source as ../Purity.UiProbe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purity.UiProbe</RootNamespace>
    <AssemblyName>Purity.UiProbe</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Purity.UiProbe\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Purity.Core\Purity.Core.csproj" />
  </ItemGroup>

</Project>
