<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A small window that checks a UI stack on a real machine. Built per candidate for the platform
    check kit (tools/platform-check): this project is Avalonia 12 on .NET 8 and 10, and
    ../Purity.UiProbe.Avalonia11 is the Avalonia 11.3 fallback built from the same source.
    Keep its Avalonia version the same as src/Purity.Desktop's, so the kit tests what ships.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purity.UiProbe</RootNamespace>
    <AssemblyName>Purity.UiProbe</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Purity.Core\Purity.Core.csproj" />
  </ItemGroup>

</Project>
