<Project Sdk="Microsoft.NET.Sdk">

  <!-- The calculation engine for every platform. It must stay pure: no file access, no logging,
       no UI, and no dependence on the machine's culture, time zone or ICU data. net8.0 exists only
       for the Monterey fallback build. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Purity.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
