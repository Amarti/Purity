<Project Sdk="Microsoft.NET.Sdk">

  <!-- The calculation engine for every platform. It must stay pure: no file access, no logging,
       no UI, and no dependence on the machine's culture, time zone or ICU data. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Purity.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The self-test's approved output. It lives with the other approved files, so it changes only
         with a rules-version bump; it was made by the old production engine. -->
    <EmbeddedResource Include="..\..\tests\Purity.Parity\Golden\self-test.txt" LogicalName="Purity.Core.SelfTest.expected.txt" Link="SelfTest.expected.txt" />
  </ItemGroup>

</Project>
