<Project Sdk="Microsoft.NET.Sdk">

  <!-- Keeps pureData.json safe: atomic saves, change detection, merging and backups. All file
       access lives here so that Purity.Core stays pure. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Purity.Storage</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Purity.Core\Purity.Core.csproj" />
    <InternalsVisibleTo Include="Purity.Storage.Tests" />
  </ItemGroup>

</Project>
