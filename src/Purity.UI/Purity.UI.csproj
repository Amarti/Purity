<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What every Purity app shares: the views and view models, the look, the words in both languages,
    the settings and the reminder connections. The desktop and Android apps are thin heads around it.
    The look began as a copy of the WPF app's on purpose: WPF is the visual baseline, and any change
    to the look needs approval. Dates come only from Purity.Core and the data file is touched only
    through Purity.Storage.
  -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purity.UI</RootNamespace>
    <AssemblyName>Purity.UI</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      12.1.5 is the version the Monterey Mac passed with. Rerun the platform check kit before changing
      it. It fixes a crash on clicking into a right-to-left text box that holds mixed-direction text
      (Avalonia #22553), which 12.1.3 had.
    -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Purity.Core\Purity.Core.csproj" />
    <ProjectReference Include="..\Purity.Storage\Purity.Storage.csproj" />
    <ProjectReference Include="..\Purity.Reminders\Purity.Reminders.csproj" />
    <InternalsVisibleTo Include="Purity" />
    <InternalsVisibleTo Include="Purity.Android" />
    <InternalsVisibleTo Include="Purity.Desktop.Tests" />
  </ItemGroup>

  <!-- The app's ID at Google comes from the environment of whoever builds it. A build without one simply doesn't offer Google. -->
  <ItemGroup Condition="'$(PURITY_GOOGLE_CLIENT_ID)' != ''">
    <AssemblyMetadata Include="GoogleClientId" Value="$(PURITY_GOOGLE_CLIENT_ID)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(PURITY_GOOGLE_CLIENT_SECRET)" Condition="'$(PURITY_GOOGLE_CLIENT_SECRET)' != ''" />
  </ItemGroup>

</Project>
