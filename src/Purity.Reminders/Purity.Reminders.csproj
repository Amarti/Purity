<Project Sdk="Microsoft.NET.Sdk">

  <!-- Turns the calculated dates into reminders, for every platform. It only reads what the
       engine produced, and the engine doesn't know it exists, so it can never change a date. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Purity.Reminders</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Purity.Core\Purity.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Purity.Reminders.Tests" />
  </ItemGroup>

</Project>
