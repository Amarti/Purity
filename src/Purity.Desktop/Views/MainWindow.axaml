<!--
  Began as a copy of the WPF app's main window: same sizes, margins and order. WPF's 710x900
  includes the window frame, so the size here is the area inside it on Windows. Changes the owner
  approved for 2.2.0: the window can be resized (T8), periods are rounded and airier (T6), and each
  kind of date has a colored chip (T4). For 2.2.1: Begin and End on their own lines, each with a
  Day | Night switch (T3b), and date fields wide enough for the whole date. For 2.2.2: the buttons
  are above the list and the newest period comes first, where WPF has them at the bottom. For
  2.2.3: all but the first period fold to one line (T2), a drop before each date replaces the Begin
  and End labels and shows whether the end is final, Remove is at the left, the wide button closes
  the open period, in place of the tick WPF has on each period (E4), that open period stays above
  the list, and an empty list says what to do first (E3). For 2.2.4: a strip above the list shows
  the next date (T1), and dates already past are greyed with a line marking today (T5).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Purity.Desktop.ViewModels"
        xmlns:core="using:Purity.Core"
        xmlns:views="using:Purity.Desktop.Views"
        x:Class="Purity.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Purity" Width="620" Height="861"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Purity.ico">

    <Window.Resources>
        <!-- A period in full, in the list and above it -->
        <DataTemplate x:Key="PeriodCardTemplate" x:DataType="vm:PeriodViewModel">
            <Border Classes="Period" Classes.Open="{Binding !IsClosed}">
                <StackPanel>
                    <!-- The two dates on their own lines (T3b), their drops starting where the line under them starts -->
                    <Grid Margin="4,0,12,0" ColumnDefinitions="25,Auto,Auto,Auto,*,Auto" RowDefinitions="25,25" RowSpacing="5">
                        <!-- The first period has Remove here, and every other accepted one the arrow that folds it -->
                        <Button Grid.RowSpan="2" Height="25" Width="25" VerticalAlignment="Center" ToolTip.Tip="Remove period" AutomationProperties.Name="Remove period" Command="{Binding RemoveCommand}" IsVisible="{Binding IsLast}">
                            <Image Height="18" Width="18" Source="{StaticResource RemoveIconDrawingImage}"/>
                        </Button>
                        <Button Grid.RowSpan="2" Theme="{StaticResource PlainButtonTheme}" HorizontalContentAlignment="Center" IsVisible="{Binding CanFold}"
                                Command="{Binding ToggleFoldCommand}" ToolTip.Tip="Fold this period" AutomationProperties.Name="Fold this period">
                            <Path HorizontalAlignment="Center" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Data="M1,1 L6,6 L11,1"/>
                        </Button>
                        <!-- A full pink drop for the start, and for the end a blue one, hollow until the period is closed. The start drop sits exactly where a folded line's does. -->
                        <Image Grid.Column="1" Margin="6,0,0,0" Height="16" Width="13" VerticalAlignment="Center" Source="{StaticResource AddPeriodIconDrawingImage}"/>
                        <views:DateField Grid.Column="2" Classes="Wpf" Margin="5,0,0,0" Width="210" SelectedDate="{Binding BeginDate}" AutomationProperties.Name="From"/>
                        <views:DayNightSwitch Grid.Column="3" Margin="6,0,0,0" IsNight="{Binding BeginIsAfterDusk}" Command="{Binding ToggleBeginNightCommand}" AutomationProperties.Name="From day or night"/>
                        <Panel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Height="16" Width="13" VerticalAlignment="Center">
                            <Image Source="{StaticResource OpenEndIconDrawingImage}" IsVisible="{Binding !IsClosed}"/>
                            <Image Source="{StaticResource ClosePeriodIconDrawingImage}" IsVisible="{Binding IsClosed}"/>
                        </Panel>
                        <views:DateField Grid.Row="1" Grid.Column="2" Classes="Wpf" Margin="5,0,0,0" Width="210" SelectedDate="{Binding EndDate}" AutomationProperties.Name="To"/>
                        <views:DayNightSwitch Grid.Row="1" Grid.Column="3" Margin="6,0,0,0" IsNight="{Binding EndIsAfterDusk}" Command="{Binding ToggleEndNightCommand}" AutomationProperties.Name="To day or night"/>
                        <!-- Last, so it ends exactly where a folded line's number ends -->
                        <CheckBox Grid.Column="5" Grid.RowSpan="2" Margin="15,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding SkipStreak}" Content="{Binding SkipLabel}"
                                  ToolTip.Tip="Omit this period from Veset Aflaga calculation due to some external reasons (surgery, intrauterine device installation, etc)"/>
                    </Grid>
                    <!-- A period still open has no dates worked out yet, so no line and nothing under it -->
                    <ListBox Classes="Events" ItemsSource="{Binding EventRows}" IsVisible="{Binding IsClosed}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventRow">
                                <StackPanel>
                                    <!-- Between the dates that have passed and those to come (T5) -->
                                    <Grid Classes="TodayLine" ColumnDefinitions="*,Auto,*" IsVisible="{Binding TodayText, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Border/>
                                        <TextBlock Grid.Column="1" Text="{Binding TodayText}"/>
                                        <Border Grid.Column="2"/>
                                    </Grid>
                                    <StackPanel Classes="EventLine" Classes.Past="{Binding IsPast}" Height="23" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Panel Margin="5,0,5,0" Height="23" Width="177">
                                            <views:EventChip Type="{Binding Event.Type}">
                                                <TextBlock Text="{Binding Event.TypeRepr}"/>
                                            </views:EventChip>
                                        </Panel>
                                        <Image Margin="5,0,5,0" Height="17" Width="17" Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding Event.IsAfterDusk}" VerticalAlignment="Center"/>
                                        <Image Margin="5,0,5,0" Height="17" Width="17" Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding Event.IsAfterDawn}" VerticalAlignment="Center"/>
                                        <Image Margin="5,0,5,0" Height="17" Width="17" Source="{StaticResource FullDayIconDrawingImage}" IsVisible="{Binding Event.IsFullDay}" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,5,5,0" Height="23" Width="60" Text="{Binding Event.StampHebRepr}" VerticalAlignment="Center"/>
                                        <TextBlock Margin="5,5,5,0" Height="23" Text="{Binding Event.StampGrgRepr}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- The periods keep the width their longest line needs, and in a wider window stay in the middle -->
    <Grid MaxWidth="620" ColumnDefinitions="20,*,20" RowDefinitions="Auto,Auto,Auto,*,Auto,20">

        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" ColumnDefinitions="40,*,40">
            <Button Grid.Column="0" Margin="-10,10,0,0" Height="30" Width="30" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                <Image Height="24" Width="24" Source="{StaticResource SettingsIconDrawingImage}"/>
            </Button>
            <!-- Adds a period, then closes it: a pink drop, then the same drop in blue. One fades into the other as it pops (E4). -->
            <Button Grid.Column="1" Margin="0,10,0,0" Height="30" HorizontalAlignment="Stretch" Command="{Binding AddOrClosePeriodCommand}" AutomationProperties.Name="{Binding AddOrCloseLabel}" ToolTip.Tip="{Binding AddOrCloseLabel}">
                <Panel>
                    <Panel Classes="WideFace" Classes.Shown="{Binding !HasOpenPeriod}">
                        <Image x:Name="NewPeriodDrop" Height="24" Width="24" Source="{StaticResource AddPeriodIconDrawingImage}">
                            <Image.RenderTransform>
                                <ScaleTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Panel>
                    <Panel Classes="WideFace" Classes.Shown="{Binding HasOpenPeriod}">
                        <Image x:Name="ClosePeriodDrop" Height="24" Width="24" Source="{StaticResource ClosePeriodIconDrawingImage}">
                            <Image.RenderTransform>
                                <ScaleTransform/>
                            </Image.RenderTransform>
                        </Image>
                    </Panel>
                </Panel>
            </Button>
            <Button Grid.Column="2" Margin="10,10,0,0" Height="30" Width="30" Command="{Binding RecalculateCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh">
                <Image Height="24" Width="24" Source="{StaticResource RefreshIconDrawingImage}"/>
            </Button>
        </Grid>

        <!-- A period still open stays in view under the button that closes it, whatever the list is showing. Its edges line up with the periods in the list. -->
        <ItemsControl Grid.Row="1" Grid.Column="1" Margin="4,0,22,8" ItemsSource="{Binding OpenPeriods}" ItemTemplate="{StaticResource PeriodCardTemplate}" IsVisible="{Binding HasOpenPeriod}"/>

        <!-- The next date (T1), in the colors of that kind of date's chip, while no period is open. In line with the periods below. -->
        <views:EventChip Grid.Row="2" Grid.Column="1" Classes="Strip" Margin="4,0,22,8" Type="{Binding NextEvent.Type}" IsVisible="{Binding ShowsNextStrip}">
            <!-- The kind, day or night icon and both dates sit exactly above those of the date rows in the list -->
            <Grid ColumnDefinitions="43.5,178,27,70,*,Auto" Height="24">
                <TextBlock Text="Next" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding NextEvent.TypeRepr}" VerticalAlignment="Center"/>
                <Panel Grid.Column="2" Height="17" Width="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding NextEvent.IsAfterDusk}"/>
                    <Image Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding NextEvent.IsAfterDawn}"/>
                    <Image Source="{StaticResource FullDayIconDrawingImage}" IsVisible="{Binding NextEvent.IsFullDay}"/>
                </Panel>
                <TextBlock Grid.Column="3" Text="{Binding NextEvent.StampHebRepr}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding NextEvent.StampGrgRepr}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Classes="NextIn" Text="{Binding NextIn}" VerticalAlignment="Center"/>
            </Grid>
        </views:EventChip>

        <ListBox x:Name="Periods" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ClosedPeriods}" ItemContainerTheme="{StaticResource PeriodItemTheme}"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- A plain stack rather than a virtualizing one, so the list always knows its height; LazyPeriod builds each period only once it's near the screen -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PeriodViewModel">
                    <views:LazyPeriod IsFolded="{Binding IsFolded}" PeriodTemplate="{StaticResource PeriodCardTemplate}">
                        <!-- A past period as one line (T2): its two dates, each with its drop, lined up from line to line -->
                        <views:LazyPeriod.FoldedTemplate>
                            <DataTemplate x:DataType="vm:PeriodViewModel">
                                <Border Classes="Period">
                                    <Button Theme="{StaticResource PlainButtonTheme}" Command="{Binding ToggleFoldCommand}" AutomationProperties.Name="{Binding BeginText, StringFormat='Open the period from {0}'}">
                                        <Grid Margin="4,0,12,0" Height="28" ColumnDefinitions="25,Auto,Auto,*,Auto">
                                            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Data="M1,1 L6,6 L1,11"/>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0" Width="210" Orientation="Horizontal" Spacing="5">
                                                <Image Height="16" Width="13" VerticalAlignment="Center" Source="{StaticResource AddPeriodIconDrawingImage}"/>
                                                <TextBlock Text="{Binding BeginText}" VerticalAlignment="Center"/>
                                                <Panel Height="15" Width="15" VerticalAlignment="Center">
                                                    <Image Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding !BeginIsAfterDusk}"/>
                                                    <Image Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding BeginIsAfterDusk}"/>
                                                </Panel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="16,0,0,0" Width="210" Orientation="Horizontal" Spacing="5">
                                                <Image Height="16" Width="13" VerticalAlignment="Center" Source="{StaticResource ClosePeriodIconDrawingImage}"/>
                                                <TextBlock Text="{Binding EndText}" VerticalAlignment="Center"/>
                                                <Panel Height="15" Width="15" VerticalAlignment="Center">
                                                    <Image Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding !EndIsAfterDusk}"/>
                                                    <Image Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding EndIsAfterDusk}"/>
                                                </Panel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding FoldedNote}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </views:LazyPeriod.FoldedTemplate>
                    </views:LazyPeriod>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- With no history yet, in the middle of the empty list: says what to do first (E3) -->
        <StackPanel Grid.Row="3" Grid.Column="1" Classes="EmptyHint" IsHitTestVisible="False" IsVisible="{Binding ShowsEmptyHint}">
            <TextBlock Classes="Title" Text="No periods yet"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="Press" VerticalAlignment="Center"/>
                <Image Height="20" Width="20" VerticalAlignment="Center" Source="{StaticResource AddPeriodIconDrawingImage}"/>
                <TextBlock Text="when one begins." VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Not in the WPF app: problems with the data file, which the new storage reports. Under the list, so one appearing never moves the periods under the pointer -->
        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF0061"
                   Text="{Binding Warning}" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Grid>
</Window>
