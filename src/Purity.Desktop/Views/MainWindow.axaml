<!--
  A copy of src/Purity.WPF/Views/MainWindow.xaml: same sizes, margins and order. WPF's 710x900
  includes the window frame, so the size here is the area inside it on Windows.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Purity.Desktop"
        xmlns:vm="using:Purity.Desktop.ViewModels"
        xmlns:core="using:Purity.Core"
        xmlns:views="using:Purity.Desktop.Views"
        x:Class="Purity.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Purity" Width="694" Height="861"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Purity.ico">

    <Grid ColumnDefinitions="20,*,20" RowDefinitions="Auto,*,Auto,Auto,20">

        <ListBox x:Name="Periods" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Periods}"
                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PeriodViewModel">
                    <Border BorderThickness="2" BorderBrush="{Binding IsClosed, Converter={x:Static local:Converters.PeriodBorder}}">
                        <StackPanel Margin="0,5,0,5" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Margin="5,5,0,0" Height="23" Text="Begin" VerticalAlignment="Center"/>
                                <views:DateField Classes="Wpf" Margin="5,0,0,0" Height="25" Width="150" SelectedDate="{Binding BeginDate}"/>
                                <Button Margin="5,0,0,0" Height="25" Width="25" VerticalAlignment="Center" Command="{Binding ToggleBeginNightCommand}" AutomationProperties.Name="Begin day or night"
                                        ToolTip.Tip="{Binding BeginIsAfterDusk, Converter={x:Static local:Converters.DuskDawnTooltip}}">
                                    <Panel>
                                        <Image Height="17" Width="17" Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding !BeginIsAfterDusk}"/>
                                        <Image Height="17" Width="17" Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding BeginIsAfterDusk}"/>
                                    </Panel>
                                </Button>
                                <TextBlock Margin="15,5,0,0" Height="23" Text="End" VerticalAlignment="Center"/>
                                <views:DateField Classes="Wpf" Margin="5,0,0,0" Height="25" Width="150" SelectedDate="{Binding EndDate}"/>
                                <Button Margin="5,0,0,0" Height="25" Width="25" VerticalAlignment="Center" Command="{Binding ToggleEndNightCommand}" AutomationProperties.Name="End day or night"
                                        ToolTip.Tip="{Binding EndIsAfterDusk, Converter={x:Static local:Converters.DuskDawnTooltip}}">
                                    <Panel>
                                        <Image Height="17" Width="17" Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding !EndIsAfterDusk}"/>
                                        <Image Height="17" Width="17" Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding EndIsAfterDusk}"/>
                                    </Panel>
                                </Button>
                                <CheckBox Margin="10,8,0,0" Height="25" Width="80" IsChecked="{Binding SkipStreak}" Content="{Binding SkipLabel}"
                                          ToolTip.Tip="Omit this period from Veset Aflaga calculation due to some external reasons (surgery, intrauterine device installation, etc)"/>
                                <!-- WPF hides these buttons without giving up their space -->
                                <Panel Margin="15,0,0,0" Height="25" Width="25">
                                    <Button Height="25" Width="25" ToolTip.Tip="Accept period" AutomationProperties.Name="Accept period" Command="{Binding AcceptCommand}" IsVisible="{Binding !IsClosed}">
                                        <Image Height="18" Width="18" Source="{StaticResource AcceptIconDrawingImage}"/>
                                    </Button>
                                </Panel>
                                <Panel Margin="15,0,5,0" Height="25" Width="25">
                                    <Button Height="25" Width="25" ToolTip.Tip="Remove period" AutomationProperties.Name="Remove period" Command="{Binding RemoveCommand}" IsVisible="{Binding IsLast}">
                                        <Image Height="18" Width="18" Source="{StaticResource RemoveIconDrawingImage}"/>
                                    </Button>
                                </Panel>
                            </StackPanel>
                            <ListBox Classes="Events" Margin="0,5,0,0" ItemsSource="{Binding SubEvents}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:PurityEvent">
                                        <StackPanel Height="23" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Margin="5,5,5,0" Height="23" Width="177" Text="{Binding TypeRepr}" VerticalAlignment="Center"/>
                                            <Image Margin="5,0,5,0" Height="17" Width="17" Source="{StaticResource AfterDuskIconDrawingImage}" IsVisible="{Binding IsAfterDusk}" VerticalAlignment="Center"/>
                                            <Image Margin="5,0,5,0" Height="17" Width="17" Source="{StaticResource AfterDawnIconDrawingImage}" IsVisible="{Binding IsAfterDawn}" VerticalAlignment="Center"/>
                                            <Image Margin="5,0,5,0" Height="17" Width="17" Source="{StaticResource FullDayIconDrawingImage}" IsVisible="{Binding IsFullDay}" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,5,5,0" Height="23" Width="60" Text="{Binding StampHebRepr}" VerticalAlignment="Center"/>
                                            <TextBlock Margin="5,5,5,0" Height="23" Text="{Binding StampGrgRepr}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="40,*,40">
            <Button Grid.Column="0" Margin="-10,10,0,0" Height="30" Width="30" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
                <Image Height="24" Width="24" Source="{StaticResource SettingsIconDrawingImage}"/>
            </Button>
            <Button Grid.Column="1" Margin="0,10,0,0" Height="30" HorizontalAlignment="Stretch" Command="{Binding AddPeriodCommand}" AutomationProperties.Name="Add period" ToolTip.Tip="{Binding AddPeriodTip}" ToolTip.ShowOnDisabled="True">
                <Image Height="24" Width="24" Source="{StaticResource AddPeriodIconDrawingImage}"/>
            </Button>
            <Button Grid.Column="2" Margin="10,10,0,0" Height="30" Width="30" Command="{Binding RecalculateCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh">
                <Image Height="24" Width="24" Source="{StaticResource RefreshIconDrawingImage}"/>
            </Button>
        </Grid>

        <!-- Not in the WPF app: problems with the data file, which the new storage reports -->
        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF0061"
                   Text="{Binding Warning}" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Grid>
</Window>
