<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop app for Windows, macOS 12 and later, and Linux: its start, the windows that hold the
    shared views, and the packaging. Everything else is in Purity.UI, which the Android app shares.
    The app runs without OS culture data, so no machine setting can change a date's text, and
    Linux needs no ICU library.
  -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purity.Desktop</RootNamespace>
    <AssemblyName>Purity</AssemblyName>
    <Product>Purity</Product>
    <ApplicationIcon>..\Purity.UI\Assets\Purity.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- dotnet run starts where Visual Studio's launch profile does, so the profile's relative paths work for both -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)/../../tests/synthetic-data</RunWorkingDirectory>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Windows gets a single Purity.exe, as the Mac gets one Purity.app and Linux one package. Its
    native libraries unpack themselves into the temp folder on the first start. Compressed, it is
    half the size and starts about as quickly.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same version as Purity.UI's Avalonia, for the same reason -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Purity.UI\Purity.UI.csproj" />
    <InternalsVisibleTo Include="Purity.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Purity.UI" />
    <Using Include="Purity.UI.Localization" />
    <Using Include="Purity.UI.ViewModels" />
    <Using Include="Purity.UI.Views" />
  </ItemGroup>

</Project>
